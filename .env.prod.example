# docker-compose.prod.yml 용 템플릿. .env.prod 로 복사해 채우세요.
#
# .gitignore 에 `.env.prod` 가 명시돼 있어 이 파일을 복사해 채워도 커밋되지 않습니다.
# (예전 경고는 해소됨 — 규칙이 추가되기 전 이야기였습니다.)
#
# /srv/vps-infra/infra/.env 와의 관계는 값마다 다릅니다 — 전부 복사하면 안 됩니다:
#   DB_PASSWORD                 = infra 의 HASI_DB_PASSWORD 와 반드시 같아야 함
#   RABBITMQ_USER / _PASSWORD   ≠ infra 의 값과 반드시 달라야 함 (계정 자체가 다름)
#   REDIS_PASSWORD              infra 에 없음 — Redis 는 이 프로젝트 전용 인스턴스
#   나머지                       infra 와 무관

# ── Postgres (infra 네트워크의 컨테이너 이름 + native 포트) ──
DB_HOST=postgres
DB_PORT=5432
DB_NAME=hasi_collab
DB_USERNAME=hasi_app
DB_PASSWORD=

# ── Redis (이 프로젝트 전용 인스턴스) ──
# 공용 인프라의 redis x.
REDIS_HOST=hasi-redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ── RabbitMQ (messenger의 STOMP relay 전용) ──
# 브로커 노드는 다른 프로젝트와 공유하지만, vhost 도 유저도 이 프로젝트 전용입니다.
# VPS에서 미리 만들어 두어야 합니다 (compose 로는 불가):
#   docker exec rabbitmq rabbitmqctl add_vhost hasi-collab
#   docker exec rabbitmq rabbitmqctl add_user  hasi <password>
#   docker exec rabbitmq rabbitmqctl set_permissions -p hasi-collab hasi ".*" ".*" ".*"
RABBITMQ_HOST=rabbitmq
RABBITMQ_STOMP_PORT=61613
RABBITMQ_VHOST=hasi-collab

# 아래 hasi 는 이 프로젝트 전용 유저입니다 — 브로커 노드 관리자가 아닙니다.
# 관리자는 vps-infra/infra/.env 의 RABBITMQ_USER(=kosmos)이고, 앱은 절대 그걸로
# 접속하지 않습니다. hasi 는 hasi-collab vhost 에만 권한이 있고 `/` 에는 없습니다.
RABBITMQ_USER=hasi

RABBITMQ_PASSWORD=

# ── JWT: service와 messenger가 반드시 같은 값을 써야 합니다 ──
JWT_SECRET=
INTERNAL_JWT_SECRET=
INTERNAL_JWT_ISSUER=hasi-service

# ── CORS: 앱 오리진(Cloudflare Workers) ──
# api.hasi-collab.com이 아니라 브라우저 주소창에 뜨는 앱 오리진입니다.
# 여러 개면 콤마로 구분. 패턴 방식이라 와일드카드도 됩니다 — 코드 수정 불필요.
CORS_ALLOWED_ORIGINS=https://hasi-collab.com

# ── OAuth 로그인 성공 후 돌아갈 프론트엔드 주소 ──
# OAuth2SuccessHandler가 여기에 /oauth2/redirect 를 붙여 리다이렉트합니다.
FRONTEND_BASE_URL=https://hasi-collab.com

# ── service -> messenger 내부 호출 ──
MESSENGER_BASE_URL=http://hasi-messenger:8081

# ── 기존 application.yml이 이미 요구하는 값들 ──
MAIL_USERNAME=
MAIL_PASSWORD=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LINE_CLIENT_ID=
LINE_CLIENT_SECRET=
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
AMAZON_CLIENT_ID=
AMAZON_CLIENT_SECRET=
NCP_BUCKET_NAME=
NCP_ACCESS_KEY=
NCP_SECRET_KEY=
