# VITE_* 값은 빌드 시점에 번들로 인라인됩니다 — 시크릿을 넣지 마세요!!!!!!!!
#
# 개발: 셋 다 비워두면 됩니다. vite.config.ts의 /api 프록시와
#       localhost 기본값(client.ts, urls.ts, messenger.ts, stomp.ts)이 그대로 동작합니다.
# 배포: 실제 값은 .env.production 에 있습니다. 여기는 형태만 보여주는 템플릿입니다.

# service(8080) REST 베이스
VITE_API_BASE_URL=https://api.example.com

# messenger(8081) REST 베이스 — /messenger-api 접두사를 포함합니다(Caddy에서 strip 금지).
VITE_MESSENGER_API_BASE_URL=https://api.example.com/messenger-api

# messenger STOMP 엔드포인트 (HTTPS 배포에서는 wss:// 필수)
VITE_WS_URL=wss://api.example.com/ws
