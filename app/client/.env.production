# `vite build`가 자동으로 읽는 파일입니다. 시크릿이 아니라 공개 URL만 들어갑니다.
#
# hasi-collab.com  -> Cloudflare Workers.

# api.hasi-collab.com = A 레코드 -> VPS IP, 반드시 Proxied(주황 구름) -> Caddy
#                        /api/*, /oauth2/*, /login/oauth2/* -> service:8080
#                        /messenger-api/*, /ws              -> messenger:8081

VITE_API_BASE_URL=https://api.hasi-collab.com
VITE_MESSENGER_API_BASE_URL=https://api.hasi-collab.com/messenger-api

# HTTPS 페이지에서 ws://는 mixed content로 차단됩니다. wss:// 필수.
VITE_WS_URL=wss://api.hasi-collab.com/ws
