{
  "name": "hasi-client",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "npm run generate:api && vite",
    "build": "npm run generate:api && tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "deploy": "npm run build && wrangler deploy",
    "generate:api": "openapi-typescript ../../docs/openapi/openapi.yaml -o ./src/types/openapi.ts"
  },
  "dependencies": {
    "@stomp/stompjs": "^7.3.0",
    "i18next": "^23.0.0",
    "lucide-react": "^1.16.0",
    "openapi-fetch": "^0.13.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^15.0.0",
    "react-router-dom": "^6.26.0",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "^26.2.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.5.0",
    "openapi-typescript": "^7.4.0",
    "postcss": "^8.5.15",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.5.3",
    "vite": "^5.4.2",
    "wrangler": "^4.116.0"
  }
}
