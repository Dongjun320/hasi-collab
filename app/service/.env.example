# app/service 개발 실행에 필요한 환경변수 템플릿입니다.
#
# pom.xml의 me.paulschwarz:springboot4-dotenv 가 모듈 작업 디렉터리의 .env를
# 읽습니다. start.sh 나 IDE에서 따로 export 하지 않아도 됩니다.
#
# 아래 13개는 application.yml에서 기본값 없이 ${...} 로만 참조하므로,
# 하나라도 비어 있으면 기동 시점에 다음과 같이 실패합니다:
#   Could not resolve placeholder 'MAIL_USERNAME' in value "${MAIL_USERNAME}"
#
# 참고:
# - app/messenger 는 모든 값에 기본값이 있어 .env 없이도 실행됩니다.
# - app/client 도 fallback이 있어 .env 없이 npm run dev 가 동작합니다.

# ── 메일 발송 (spring.mail / smtp.gmail.com:587) ──────────────
# Gmail 계정과 앱 비밀번호. 이메일 인증·비밀번호 재설정에 사용됩니다.
MAIL_USERNAME=
MAIL_PASSWORD=

# ── OAuth2 소셜 로그인 ────────────────────────────────────────
# 각 provider 콘솔에서 발급받은 client id / secret.
# 미설정 시에도 기동은 하지만(빈 문자열이면 placeholder는 해결됨) 해당
# provider 로그인은 실패합니다.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

LINE_CLIENT_ID=
LINE_CLIENT_SECRET=

TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=

AMAZON_CLIENT_ID=
AMAZON_CLIENT_SECRET=

# ── NCP Object Storage (파일 업로드) ──────────────────────────
# endpoint/region 은 application.yml에 하드코딩되어 있고, 아래 3개만 주입합니다.
NCP_BUCKET_NAME=
NCP_ACCESS_KEY=
NCP_SECRET_KEY=
